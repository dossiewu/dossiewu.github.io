---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";

---

<Layout>
  <Header />
  <main id="main-content">
    <div class="home-container">
      <img src="/profile.jpg" alt="Xunhui Wu" class="profile-img" />

      <div class="terminal-card">
        <div class="window-header">
          <span class="dot red"></span>
          <span class="dot yellow"></span>
          <span class="dot green"></span>
          <span class="file-name">portfolio.tsx</span>
        </div>

        <div class="window-content">
          <p class="greeting">> Hello, I'm</p>
            <h1 style="font-family: monospace; letter-spacing: -0.02em;">
              Xunhui Wu
            </h1>
          <p class="typing-text">Neuroscience Ph.D. Candidate | Circuit Dynamics</p>
          
          <div class="bio-details">
            <p>// Graduate Researcher at Northwestern University</p>
            <p>// Focus: Neuropsychiatric & Movement Disorders</p>
            <p>// Expertise: <em>in vivo</em> Calcium Imaging & Pharmacology</p>
            <p>// NIMH T32 Trainee in Neurobiology of Information Storage Training Program</p>
          </div>

          <div class="button-group">
            <a href="/research" class="btn-primary">View My Research</a>
            <a href="/contact" class="btn-secondary">Get In Touch</a>
          </div>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  /* This centers everything and puts them in a row */
  .home-container {
    display: flex;
    flex-direction: column; /* Default: Stack them (Mobile) */
    align-items: center;
    justify-content: center;
    gap: 2rem;
    padding: 2rem 1rem;
    margin: 0 auto;
    max-width: 100%; /* Ensure it doesn't overflow on phone */
  }

  /* DESKTOP RULES (When screen is wider than 1024px) */
  @media (min-width: 1024px) {
    .home-container {
      flex-direction: row; /* Force side-by-side */
      align-items: center; /* Center them vertically */
      gap: 1rem; /* More space between pic and card */
      max-width: 1400px; /* Give them plenty of room to breathe */
    }
    
    /* Optional: If the card gets too tall, this keeps the image aligned nicely */
    .profile-img {
      margin-bottom: 0; 
    }
  }
  /* This controls your profile photo size */
  .profile-img {
    width: 400px;
    height: 350px;
    object-fit: cover; /* Prevents stretching */
    border-radius: 20px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.15);
  }

  .terminal-card {
    background: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    max-width: 600px;
    margin: 2rem auto;
    overflow: hidden;
    font-family: 'JetBrains Mono', monospace; /* Monospace is key for that dev look */
  }

  .window-header {
    background: #f5f5f5;
    padding: 10px;
    display: flex;
    align-items: center;
    border-bottom: 1px solid #e0e0e0;
  }

  .dot { height: 12px; width: 12px; border-radius: 50%; margin-right: 8px; }
  .red { background: #ff5f56; }
  .yellow { background: #ffbd2e; }
  .green { background: #27c93f; }

  .file-name { color: #666; font-size: 0.8rem; margin-left: 10px; }

  .window-content { padding: 30px; }
  
  h1 { color: #4f46e5; font-size: 2.5rem; margin: 0.5rem 0; }
  .greeting { color: #10b981; margin: 0; }
  .typing-text { font-size: 1.2rem; color: #333; font-weight: bold; }
  .bio-details { color: #6b7280; margin: 1.5rem 0; line-height: 1.6; }

/* 1. The Iridescent Gradient for your Name/Logo */
  h1, .logo-text {
    background: linear-gradient(135deg, #6366f1 0%, #a855f7 50%, #ec4899 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-size: 200% auto;
    transition: 0.5s;
  }
  
  h1:hover {
    background-position: right center; /* Shifts the gradient on hover */
  }

  /* 2. Button Styles */
  .button-group {
    display: flex;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .btn-primary, .btn-secondary {
    padding: 0.8rem 1.5rem;
    border-radius: 8px;
    font-weight: 600;
    transition: all 0.3s ease; /* Makes the "light up" smooth */
    text-decoration: none;
    display: inline-block;
  }

  .btn-primary {
    background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
    color: white;
    border: none;
  }

  .btn-primary:hover {
    transform: translateY(-2px); /* Slight lift */
    box-shadow: 0 5px 15px rgba(99, 102, 241, 0.4); /* The "glow" */
    filter: brightness(1.1);
  }

  .btn-secondary {
    background: white;
    color: #6366f1;
    border: 1px solid #e0e0e0;
  }

  .btn-secondary:hover {
    background: #f8fafc;
    border-color: #6366f1;
    color: #4f46e5;
  }

  :global(.logo), :global(.logo a) { 
    background: linear-gradient(135deg, #6366f1 0%, #a855f7 50%, #ec4899 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    color: transparent !important; /* Forces the text to be transparent so gradient shows */
    font-weight: 800;
    font-family: 'JetBrains Mono', monospace;
    text-decoration: none;
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
